# Newton's Hub — environment variables
# Copy to .env for local development. Never commit real values.
# On Vercel, add these under Project → Settings → Environment Variables.

# --- Supabase (required) -----------------------------------------------------
# Project URL and publishable (anon) key: Supabase dashboard → Project Settings → API.
# The publishable key is safe to expose to browsers; row-level security protects data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Service role / secret key — SERVER ONLY. Used by checkout, sell/swap and admin
# server functions after they verify the signed-in user. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Newton's AI (optional but recommended) -----------------------------------
# Anthropic API key for the shopping assistant. Without it the assistant still works,
# answering from the live catalog with built-in rules instead of the language model.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5).
AI_MODEL=

# --- Optional ----------------------------------------------------------------
# Show "Continue with Google" outside Lovable hosting. Only enable after configuring
# the Google provider in Supabase → Authentication → Providers.
VITE_ENABLE_GOOGLE_AUTH=false
